# 内部 API 默认只监听本机；容器间调用时改为 0.0.0.0，但不要直接暴露公网。
XIANYU_HOST=127.0.0.1
XIANYU_PORT=8090
XIANYU_LOG_LEVEL=INFO

# Java -> Python 的 HMAC 密钥。未配置时所有 /internal 接口拒绝服务。
XIANYU_INTERNAL_SECRET=replace-with-a-long-random-secret

# Python -> Java 事件回调；两项同时配置才会发送。
LXJ_EVENT_CALLBACK_URL=http://127.0.0.1:48080/admin-api/lxj/xianyu/event
LXJ_EVENT_CALLBACK_SECRET=replace-with-a-long-random-secret

XIANYU_OUTBOX_PATH=./data/events.db

# 每个账号独立保存 Cookie；目录权限 0700、文件权限 0600。
XIANYU_ACCOUNTS_DIR=./data/accounts

# 运行中发现 account_cli.py 新增或移除的账号。
XIANYU_ACCOUNT_SYNC_INTERVAL=5

# WebSocket 事件可能漏报，按秒轮询卖家订单列表做状态补偿；最小值为 5。
XIANYU_ORDER_POLL_INTERVAL=60
